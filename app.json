{
  "expo": {
    "name": "WikiMind",
    "slug": "wikimind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4C44A8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wikimind.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WikiMind 需要麦克风权限以录制语音笔记",
        "NSCameraUsageDescription": "WikiMind 需要摄像头权限以拍照识别文字",
        "NSPhotoLibraryUsageDescription": "WikiMind 需要相册权限以选择图片"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4C44A8"
      },
      "package": "com.wikimind.app",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-av",
        {
          "microphonePermission": "WikiMind 需要麦克风权限以录制语音笔记"
        }
      ]
    ]
  }
}
